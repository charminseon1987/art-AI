# API Keys - 실제 키로 교체하세요
OPENAI_API_KEY=your-openai-api-key-here
SERPER_API_KEY=your-serper-api-key-here
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
OpenWeather=your-openweather-api-key-here
ExchangeRate-API=your-exchange-rate-api-key-here

# 프론트엔드 URL (Cloudflare Pages 배포시)
FRONTEND_URL=https://your-frontend-domain.pages.dev

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Resend Email
RESEND_API_KEY=re_your-resend-api-key-here
FROM_EMAIL=noreply@yourdomain.com

# Google Ads (전환 추적, 리마케팅)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AbC123xyz
