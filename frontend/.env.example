# 환경 변수 예시 파일
# .env.local 또는 .env.production 파일을 생성하여 사용하세요

# Python 백엔드 API URL
# 로컬 개발: http://localhost:8000
# Cloudflare Tunnel: https://api.yourdomain.com 또는 https://your-tunnel-url.trycloudflare.com
PYTHON_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_PYTHON_BACKEND_URL=http://localhost:8000

# Supabase (인증 및 데이터베이스)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Stripe Payment (프론트엔드용)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Polar.sh Checkout (결제 실패 시 아래를 확인하세요)
# - POLAR_ACCESS_TOKEN: Polar 대시보드에서 발급한 Organization Access Token (필수)
# - POLAR_SUCCESS_URL: 반드시 절대 URL (https://...) 이어야 함. 상대 경로 사용 시 결제 후 리다이렉트 실패
# - 배포 시: POLAR_SUCCESS_URL을 실제 도메인으로 설정 (예: https://your-app.pages.dev/payment/success?checkout_id={CHECKOUT_ID})
# - 샌드박스: POLAR_SERVER 설정 안 함 또는 sandbox. 운영: POLAR_SERVER=production
POLAR_ACCESS_TOKEN=polar_oat_xxx
POLAR_SUCCESS_URL=http://localhost:3000/payment/success?checkout_id={CHECKOUT_ID}
NEXT_PUBLIC_POLAR_PRODUCT_ID=a86a8df2-1f4f-4fc5-bed8-176aafe178c7
# (선택) successUrl 미설정 시 리다이렉트 기준 URL. 배포 시 예: https://your-app.pages.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Pages 배포 시
# NEXT_PUBLIC_PYTHON_BACKEND_URL은 Cloudflare Tunnel URL로 설정
# 예: NEXT_PUBLIC_PYTHON_BACKEND_URL=https://api.yourdomain.com

# Resend Email (백엔드에서 사용, 프론트엔드에서는 사용하지 않음)
# RESEND_API_KEY=re_your-resend-api-key-here